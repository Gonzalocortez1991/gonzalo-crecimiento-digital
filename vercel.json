    { "source": "/GRACIAS-5AREAS.html", "destination": "/landings/GRACIAS-5AREAS.html" },
    { "source": "/FORMULARIO-DIAGNOSTICO-GCD.html", "destination": "/landings/FORMULARIO-DIAGNOSTICO-GCD.html" },
    { "source": "/DIAGNOSTICO-5-AREAS.html", "destination": "/landings/DIAGNOSTICO-5-AREAS.html" },
    { "source": "/CALCULADORA-PERDIDA-DESORDEN.html", "destination": "/landings/CALCULADORA-PERDIDA-DESORDEN.html" },
    { "source": "/landings/LANDING-GCD.html", "destination": "/LANDING-GCD.html" },
    { "source": "/alaya/", "destination": "/alaya/LANDING-CENTRAL-ESCALAMIENTO.html" },
