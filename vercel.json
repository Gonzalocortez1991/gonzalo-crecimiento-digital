{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.calendly.com https://connect.facebook.net https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.calendly.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://*.calendly.com https://script.google.com https://script.googleusercontent.com https://www.facebook.com https://www.google-analytics.com https://www.googletagmanager.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://calendly.com https://assets.calendly.com https://script.google.com https://script.googleusercontent.com; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://calendly.com https://assets.calendly.com https://connect.facebook.net https://www.facebook.com https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/links", "destination": "/INDEX-GCD-LINKS.html" },
    { "source": "/referidos", "destination": "/LINKS-REFERIDOS-GCD.html" },
    { "source": "/privacidad", "destination": "/privacidad.html" },
    { "source": "/muestra", "destination": "/sample-codigo-de-fuga.html" },
    { "source": "/sistema", "destination": "/SISTEMA-ESCALAMIENTO.html" },
    { "source": "/toolkit", "destination": "/toolkit-prompts-gcd.html" },
    { "source": "/hooks", "destination": "/BANCO-HOOKS.html" },
    { "source": "/pack-starter", "destination": "/landings/LANDING-PACK-STARTER.html" },
    { "source": "/5-areas", "destination": "/landings/LANDING-5-AREAS.html" },
    { "source": "/diagnostico", "destination": "/landings/FORMULARIO-DIAGNOSTICO-GCD.html" },
    { "source": "/diagnostico.pdf", "destination": "/assets/DIAGNOSTICO-GCD-LINK.pdf" },
    { "source": "/WEBINAR-5-AREAS.html", "destination": "/landings/WEBINAR-5-AREAS.html" },
    { "source": "/PLAN-15-MIN-DIA.html", "destination": "/landings/PLAN-15-MIN-DIA.html" },
    { "source": "/LANDING-SISTEMA-5-PILARES.html", "destination": "/landings/LANDING-SISTEMA-5-PILARES.html" },
    { "source": "/LANDING-PLAN-15.html", "destination": "/landings/LANDING-PLAN-15.html" },
    { "source": "/LANDING-PACK-STARTER.html", "destination": "/landings/LANDING-PACK-STARTER.html" },
    { "source": "/LANDING-DIAGNOSTICO.html", "destination": "/landings/LANDING-DIAGNOSTICO.html" },
    { "source": "/LANDING-CALCULADORA.html", "destination": "/landings/LANDING-CALCULADORA.html" },
    { "source": "/LANDING-5-AREAS.html", "destination": "/landings/LANDING-5-AREAS.html" },
    { "source": "/GRACIAS-PLAN15.html", "destination": "/landings/GRACIAS-PLAN15.html" },
    { "source": "/GRACIAS-PACK.html", "destination": "/landings/GRACIAS-PACK.html" },
    { "source": "/GRACIAS-DIAGNOSTICO.html", "destination": "/landings/GRACIAS-DIAGNOSTICO.html" },
    { "source": "/GRACIAS-COMPRA.html", "destination": "/landings/GRACIAS-COMPRA.html" },
